# Copy this file to .env on Byte-Me.  Never commit your real token.
ADMIN_TOKEN=replace-with-a-long-random-admin-token
POLL_SECONDS=30
# Leave this default when the AD53 Shared App Updater is installed on Byte-Me.
SHARED_UPDATER_URL=http://host.docker.internal:8093/apps/results-page

# RaceTec custom SFTP upload endpoint. Use a DNS-only hostname that points to
# Byte-Me's public IP, not a Cloudflare-proxied hostname.
SFTP_PUBLIC_HOST=racetec-upload.example.com
RACETEC_SFTP_USERNAME=racetec
RACETEC_SFTP_PASSWORD=replace-with-a-long-unique-password
